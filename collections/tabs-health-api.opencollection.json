{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tabs External Billing Terms Health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Liveness check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://integrators.prod.api.tabsplatform.com/health/live"
          },
          "docs": "Liveness check"
        },
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://integrators.prod.api.tabsplatform.com/health"
          },
          "docs": "Health check"
        },
        {
          "info": {
            "name": "Application information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://integrators.prod.api.tabsplatform.com/info"
          },
          "docs": "Returns basic information about the application including name, version, and description"
        }
      ]
    }
  ],
  "bundled": true
}