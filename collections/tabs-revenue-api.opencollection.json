{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tabs External Billing Terms Revenue API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Revenue",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List revenue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://integrators.prod.api.tabsplatform.com/v3.1/revenue",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page Number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "\n            Supported items for filter: startMonth, endMonth, customerId, currency.\n\n            Months should be in YYYY-MM format.\n\n            Currency should be an ISO 4217 currency code (e.g., USD, INR, EUR).\n            "
              }
            ]
          },
          "docs": "List revenue"
        }
      ]
    }
  ],
  "bundled": true
}