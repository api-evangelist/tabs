{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tabs External Billing Terms Items API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://integrators.prod.api.tabsplatform.com/v3/items",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page Number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items to return"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "\n        Supported items for filter: name, externalId, externalIdType\n\n        Acceptable externalIdTypes: QUICKBOOKS, NETSUITE, RILLET, SAGE_INTACCT, SALESFORCE, HUBSPOT, AVALARA, ANROK, STRIPE\n        "
              }
            ]
          },
          "docs": "List items"
        },
        {
          "info": {
            "name": "Get item by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://integrators.prod.api.tabsplatform.com/v3/items/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Item Id"
              }
            ]
          },
          "docs": "Get item by ID"
        }
      ]
    }
  ],
  "bundled": true
}