{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tabs External Billing Terms Obligations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Obligations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List obligations",
